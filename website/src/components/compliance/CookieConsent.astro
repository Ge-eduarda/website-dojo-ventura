---
/**
 * 🍪 CookieConsent.astro — CMP Internacional de Conformidade Real (GDPR / CCPA / LGPD)
 * Baseado no padrão Klaro / Consent Mode v2.
 * NUNCA use banners fake de 2018. Este componente bloqueia scripts reais até o opt-in.
 */
interface Props {
  companyName?: string;
  privacyPolicyUrl?: string;
}

const {
  companyName = 'Dojo Ventura',
  privacyPolicyUrl = '/privacy',
} = Astro.props;
---

<div
  id="cookie-consent-modal"
  class="fixed inset-x-0 bottom-0 z-50 p-4 sm:p-6 hidden transition-all duration-300"
  role="region"
  aria-label="Gerenciamento de Privacidade e Cookies"
>
  <div class="mx-auto max-w-4xl border border-line bg-white p-6 shadow-hard">
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div class="space-y-1">
        <h3 class="font-display text-fluid-h3 font-bold text-ink uppercase flex items-center gap-2">
          <span class="text-lg">🛡️</span> Suas Preferências de Privacidade (GDPR / LGPD)
        </h3>
        <p class="text-xs text-ink-soft leading-relaxed max-w-2xl">
          Nós e parceiros selecionados usamos cookies e tecnologias similares para garantir o funcionamento do site, medir audiência e personalizar anúncios. Você pode aceitar todos, rejeitar os não essenciais ou personalizar suas escolhas a qualquer momento. Leia nossa <a href={privacyPolicyUrl} class="font-medium text-brand-600 underline hover:text-brand-700">Política de Privacidade</a>.
        </p>
      </div>

      <!-- Botões de Ação Imediata (Mesmo peso visual conforme exigência da UE) -->
      <div class="flex flex-wrap items-center gap-2 sm:flex-nowrap">
        <button
          type="button"
          id="btn-reject-all"
          class="w-full sm:w-auto border border-line-strong px-4 py-2 text-xs font-bold text-ink transition hover:bg-surface-alt"
        >
          Rejeitar Não Essenciais
        </button>
        <button
          type="button"
          id="btn-customize-consent"
          class="w-full sm:w-auto border border-line-strong px-4 py-2 text-xs font-bold text-ink transition hover:bg-surface-alt"
        >
          Preferências
        </button>
        <button
          type="button"
          id="btn-accept-all"
          class="w-full sm:w-auto bg-brand-600 px-5 py-2 text-xs font-bold text-white shadow-hard transition hover:bg-brand-700"
        >
          Aceitar Todos
        </button>
      </div>
    </div>

    <!-- Painel de Preferências Expandido (Dropdown/Accordion) -->
    <div id="consent-preferences-panel" class="mt-4 hidden border-t border-line pt-4">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs">
        <div class="border border-line bg-surface-alt p-3">
          <div class="flex items-center justify-between">
            <span class="font-bold text-ink">Estritamente Necessários</span>
            <span class="text-[10px] font-bold text-brand-600 uppercase">Sempre Ativo</span>
          </div>
          <p class="mt-1 text-ink-muted">Essenciais para segurança (Cloudflare Turnstile), sessões e navegação.</p>
        </div>

        <div class="border border-line p-3">
          <div class="flex items-center justify-between">
            <span class="font-bold text-ink">Métricas & Analytics</span>
            <input type="checkbox" id="consent-analytics" class="h-4 w-4 border-line-strong text-brand-600 focus:ring-brand-600" />
          </div>
          <p class="mt-1 text-ink-muted">Coleta anônima de desempenho e fluxo de navegação para melhorias.</p>
        </div>

        <div class="border border-line p-3">
          <div class="flex items-center justify-between">
            <span class="font-bold text-ink">Marketing & Ads</span>
            <input type="checkbox" id="consent-marketing" class="h-4 w-4 border-line-strong text-brand-600 focus:ring-brand-600" />
          </div>
          <p class="mt-1 text-ink-muted">Pixels de conversão para mensurar eficiência de campanhas de tráfego.</p>
        </div>
      </div>

      <div class="mt-4 flex justify-end">
        <button
          type="button"
          id="btn-save-preferences"
          class="bg-ink px-4 py-2 text-xs font-bold text-white transition hover:bg-slate-800"
        >
          Salvar Minhas Escolhas
        </button>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (() => {
    const STORAGE_KEY = 'sanb_cookie_consent_v2';
    const modal = document.getElementById('cookie-consent-modal');
    const panel = document.getElementById('consent-preferences-panel');

    const checkConsent = () => {
      try {
        const saved = localStorage.getItem(STORAGE_KEY);
        if (!saved) {
          modal?.classList.remove('hidden');
        } else {
          const consent = JSON.parse(saved);
          applyConsent(consent);
        }
      } catch (e) {
        modal?.classList.remove('hidden');
      }
    };

    const applyConsent = (consent) => {
      // Dispara evento global para o Google Tag Manager / PostHog
      window.dispatchEvent(new CustomEvent('sanb:consent:updated', { detail: consent }));
      if (window.dataLayer) {
        window.dataLayer.push({
          event: 'consent_update',
          analytics_storage: consent.analytics ? 'granted' : 'denied',
          ad_storage: consent.marketing ? 'granted' : 'denied',
        });
      }
    };

    const saveConsent = (analytics, marketing) => {
      const consent = {
        necessary: true,
        analytics: Boolean(analytics),
        marketing: Boolean(marketing),
        timestamp: new Date().toISOString(),
        version: '2.0-gdpr-compliant',
      };
      localStorage.setItem(STORAGE_KEY, JSON.stringify(consent));
      applyConsent(consent);
      modal?.classList.add('hidden');
    };

    document.getElementById('btn-accept-all')?.addEventListener('click', () => saveConsent(true, true));
    document.getElementById('btn-reject-all')?.addEventListener('click', () => saveConsent(false, false));

    document.getElementById('btn-customize-consent')?.addEventListener('click', () => {
      panel?.classList.toggle('hidden');
    });

    document.getElementById('btn-save-preferences')?.addEventListener('click', () => {
      const analytics = document.getElementById('consent-analytics')?.checked;
      const marketing = document.getElementById('consent-marketing')?.checked;
      saveConsent(analytics, marketing);
    });

    // Inicializa na carga da página
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', checkConsent);
    } else {
      checkConsent();
    }
  })();
</script>
