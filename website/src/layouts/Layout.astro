---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyMobileCTA from '../components/StickyMobileCTA.astro';
import CookieConsent from '../components/compliance/CookieConsent.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  lang?: string;
}

const {
  title,
  description = 'Soluções digitais de alta performance construídas com Astro 7 e Cloudflare.',
  image = '/og-image.jpg',
  lang = 'pt-BR',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://exemplo.com.br');
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- 🎬 ClientRouter (Astro 7+): View Transitions fluidas a 120fps sem piscar a tela -->
    <ClientRouter fallback="swap" />

    <!-- SEO Primário -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />

    <!-- Google Fonts: Oswald (destaque esportivo) + DM Sans (corpo) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen bg-white text-ink font-sans antialiased flex flex-col pb-16 md:pb-0" transition:animate="fade">
    <!-- Acessibilidade WCAG 2.2 AA: Skip link para navegação por teclado -->
    <a
      href="#conteudo-principal"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-brand-600 focus:px-4 focus:py-2 focus:text-white focus:shadow-hard focus:outline-none focus:ring-2 focus:ring-brand-600"
    >
      Pular para o conteúdo principal
    </a>

    <Header transition:persist />
    <main id="conteudo-principal" class="flex-grow focus:outline-none" tabindex="-1">
      <slot />
    </main>
    <Footer transition:persist />

    <!-- CRO & Conversão Mobile (Fixa no rodapé para smartphones) -->
    <StickyMobileCTA
      phoneNumber="5518999999999"
      message="Olá! Gostaria de um orçamento para meu projeto."
      telephoneNumber="+551832220000"
    />

    <!-- 🍪 CMP Internacional: Banner de Cookies & Privacidade (Klaro / GDPR / CCPA / LGPD) -->
    <CookieConsent companyName="Dojo Ventura" privacyPolicyUrl="/privacy" />
  </body>
</html>
