---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'button'> {
  variant?: 'primary' | 'secondary' | 'outline' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  as?: 'button' | 'a';
  href?: string;
}

const {
  variant = 'primary',
  size = 'md',
  as = 'button',
  href,
  class: className = '',
  ...props
} = Astro.props;

// Cantos retos (sem rounded) — identidade "formas retas".
const baseStyles = 'inline-flex items-center justify-center font-bold transition focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-600 focus-visible:ring-offset-2 disabled:opacity-50 disabled:pointer-events-none cursor-pointer';

const variantStyles = {
  primary: 'bg-brand-600 text-white hover:bg-brand-700 shadow-hard',
  secondary: 'bg-ink text-white hover:bg-slate-800',
  outline: 'border border-line-strong text-ink hover:border-brand-600 hover:text-brand-700',
  ghost: 'text-ink hover:bg-surface-alt',
};

const sizeStyles = {
  sm: 'text-xs px-3 py-1.5 gap-1.5',
  md: 'text-sm px-4 py-2 gap-2',
  lg: 'text-base px-6 py-3 gap-2.5',
};

const classes = `${baseStyles} ${variantStyles[variant]} ${sizeStyles[size]} ${className}`;
---

{
  as === 'a' ? (
    <a href={href} class={classes} {...(props as HTMLAttributes<'a'>)}>
      <slot />
    </a>
  ) : (
    <button class={classes} {...props}>
      <slot />
    </button>
  )
}
