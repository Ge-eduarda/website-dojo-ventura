---
interface Props {
  siteName?: string;
}

const { siteName = 'Dojo Ventura' } = Astro.props;

// Marca o link atual (aria-current) para navegação clara em qualquer página
const pathname = Astro.url.pathname.replace(/\/$/, '');

const links = [
  { href: '/', label: 'Início' },
  { href: '/#escola', label: 'A Escola' },
  { href: '/atletas', label: 'Atletas' },
  { href: '/apoiar', label: 'Apoiar' },
  { href: '/#contato', label: 'Contato' },
];

const isActive = (href: string) => (href === '/' ? pathname === '' : pathname === href);

const navBase = 'px-1 py-2 font-display text-[20px] font-bold uppercase tracking-wide transition';
const navIdle = 'text-ink-soft hover:text-ink';
const navActive = 'text-ink';
---

<header class="sticky top-0 z-50 border-b border-line bg-white text-ink">
  <!-- Filete dourado/vermelho: identidade do escudo do dojo -->
  <div class="h-1 bg-gradient-to-r from-brand-600 via-gold-500 to-brand-600" aria-hidden="true"></div>

  <div class="w-full flex h-16 items-center justify-between gap-4 px-3 sm:px-4 lg:px-6 lg:h-20">
    <a href="/" class="flex items-center gap-3" aria-label="Dojo Ventura — início">
      <!-- Monograma provisório até a logo oficial em alta chegar (cantos retos) -->
      <span class="flex h-10 w-10 shrink-0 items-center justify-center border-2 border-gold-500 bg-brand-600 font-display text-lg font-black text-white" aria-hidden="true">V</span>
      <span class="leading-tight">
        <span class="block font-display text-lg font-bold tracking-tight text-ink uppercase">{siteName}</span>
        <span class="block text-[10px] font-bold uppercase tracking-[0.18em] text-gold-600">Karatê · Regente Feijó</span>
      </span>
    </a>

    <nav class="hidden items-center gap-7 lg:flex" aria-label="Navegação principal">
      {links.map((l) => (
        <a
          href={l.href}
          aria-current={isActive(l.href) ? 'page' : undefined}
          class={`${navBase} ${isActive(l.href) ? navActive : navIdle}`}
        >
          {l.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <a
        href="/apoiar"
        class="hidden min-h-[44px] items-center justify-center bg-brand-600 px-5 text-[20px] font-display font-bold uppercase tracking-wide text-white shadow-hard transition hover:bg-brand-700 sm:inline-flex"
      >
        Apoiar a equipe
      </a>

      <!-- Menu mobile sem JavaScript (HTML details/summary) -->
      <details class="relative lg:hidden">
        <summary
          class="flex h-11 w-11 cursor-pointer list-none items-center justify-center border border-line text-ink [&::-webkit-details-marker]:hidden"
          aria-label="Abrir menu de navegação"
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16" />
          </svg>
        </summary>
        <nav class="absolute right-0 top-12 z-50 w-60 border border-line bg-white p-2 shadow-hard" aria-label="Navegação móvel">
          {links.map((l) => (
            <a
              href={l.href}
              class="block px-3 py-2.5 font-display text-[20px] font-bold uppercase tracking-wide text-ink transition hover:bg-surface-alt hover:text-ink"
            >
              {l.label}
            </a>
          ))}
          <a href="/apoiar" class="mt-1 block bg-brand-600 px-3 py-2.5 text-center font-display text-[20px] font-bold uppercase tracking-wide text-white transition hover:bg-brand-700">
            Apoiar a equipe
          </a>
        </nav>
      </details>
    </div>
  </div>
</header>
