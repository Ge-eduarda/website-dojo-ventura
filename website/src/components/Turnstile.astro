---
interface Props {
  siteKey?: string;
  theme?: 'light' | 'dark' | 'auto';
  size?: 'normal' | 'compact' | 'flexible';
}

const {
  siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '1x00000000000000000000AA', // Chave de teste sempre válida da Cloudflare
  theme = 'auto',
  size = 'normal',
} = Astro.props;
---

<div class="cf-turnstile my-2" data-sitekey={siteKey} data-theme={theme} data-size={size}></div>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
