---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import Turnstile from '../components/Turnstile.astro';
import { site, pix, vaquinha, athletes, costs, giveAmounts } from '../data/dojo';
---

<Layout
  title="Dojo Ventura — Karatê em Regente Feijó | Apoie nossos atletas"
  description="Centro de Treinamento de Karatê em Regente Feijó (Oeste Paulista): ação social com jovens + equipe de alto rendimento. Apoie via PIX, depósito ou vaquinha e leve nossos atletas ao Brasil e ao mundo."
>
  <!-- HERO DA CAUSA (branco dominante + cantos retos) -->
  <section class="relative isolate overflow-hidden bg-white text-ink">
    <div class="absolute inset-x-0 top-0 h-1.5 bg-gradient-to-r from-brand-600 via-gold-500 to-brand-600" aria-hidden="true"></div>
    <div class="mx-auto max-w-7xl px-3 sm:px-4 lg:px-6 py-20 sm:py-28">
      <div class="max-w-3xl border-l-4 border-l-brand-600 pl-6 sm:pl-8">
        <p class="inline-flex items-center gap-2 border border-gold-500 bg-surface-alt px-3 py-1 text-xs font-bold text-gold-600 mb-6">
          🥋 Regente Feijó · Oeste Paulista — karatê social + alto rendimento
        </p>
        <h1 class="font-display text-fluid-h1 font-extrabold tracking-tight leading-tight text-ink uppercase">
          Nossos atletas vencem no tatame.<br />
          <span class="text-brand-600">Fora dele, precisam de você.</span>
        </h1>
        <p class="mt-6 text-fluid-body text-ink-soft leading-relaxed">
          O {site.name} forma jovens pelo esporte e disputa torneios por todo o Brasil —
          com atleta na <strong class="text-ink">Seleção Brasileira</strong>. O gargalo é financeiro:
          viagens para fora de SP custam caro. Sua doação vira passagem, hospedagem e inscrição.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <Button as="a" href="/apoiar" size="lg" variant="primary">Apoiar agora — PIX / Vaquinha</Button>
          <Button as="a" href="/atletas" size="lg" variant="outline">Conhecer os atletas</Button>
        </div>
        <!-- Chips com fatos reais já publicados na página (cantos retos) -->
        <ul class="mt-8 flex flex-wrap gap-2 text-xs font-bold">
          {[
            'Atleta na Seleção Brasileira',
            'Ação social com jovens',
            'Competições SP · Brasil e mundo',
          ].map((chip) => (
            <li class="inline-flex items-center gap-2 border border-line bg-white px-3 py-1.5 text-ink-soft">
              <span class="h-2 w-2 bg-brand-600" aria-hidden="true"></span>
              {chip}
            </li>
          ))}
        </ul>
        <p class="mt-6 text-xs text-ink-muted">Doação por PIX, depósito bancário ou vaquinha online · Prestação de contas pública</p>
      </div>
    </div>
  </section>

  <!-- BARRA PIX -->
  <section aria-label="Doação rápida via PIX" class="border-y border-line bg-surface-alt">
    <div class="mx-auto flex max-w-7xl flex-col sm:flex-row items-center justify-between gap-4 px-3 sm:px-4 lg:px-6 py-5">
      <p class="text-sm font-bold text-ink">
        ⚡ Doação rápida: <span class="font-mono">{pix.pending ? 'Chave PIX em confirmação' : pix.key}</span>
      </p>
      <div class="flex gap-3">
        <a href="/apoiar" class="inline-flex min-h-[44px] items-center bg-brand-600 px-5 py-2 text-sm font-bold text-white shadow-hard transition hover:bg-brand-700">Ver como doar</a>
        <a href={vaquinha.pending ? '/apoiar' : vaquinha.url} class="inline-flex min-h-[44px] items-center border border-line-strong px-5 py-2 text-sm font-bold transition hover:border-brand-600 hover:text-brand-700">Vaquinha ↗</a>
      </div>
    </div>
  </section>

  <!-- A ESCOLA / AÇÃO SOCIAL -->
  <section id="escola" class="py-20 bg-white">
    <div class="mx-auto max-w-7xl px-3 sm:px-4 lg:px-6 grid gap-12 md:grid-cols-2 items-center">
      <div>
        <h2 class="font-display text-fluid-h2 font-bold tracking-tight text-ink uppercase">Escola + projeto social: disciplina que muda vidas</h2>
        <p class="mt-4 text-ink-soft leading-relaxed">
          O Dojo Ventura é o centro de treinamento de karatê de Regente Feijó. Além das aulas,
          mantém uma ação social que prepara jovens para o esporte — e para a vida: respeito,
          disciplina, saúde e perspectiva de futuro através das competições.
        </p>
        <ul class="mt-6 space-y-3 text-sm text-ink-soft">
          <li class="flex gap-2"><span class="font-bold text-brand-600">✓</span> Aulas de karatê para iniciantes e avançados <span class="text-ink-muted">(horários em confirmação)</span></li>
          <li class="flex gap-2"><span class="font-bold text-brand-600">✓</span> Formação de jovens atletas para torneios estaduais, nacionais e internacionais</li>
          <li class="flex gap-2"><span class="font-bold text-brand-600">✓</span> Atleta do dojo convocado para a Seleção Brasileira</li>
        </ul>
        <div class="mt-6 flex flex-wrap gap-2">
          <span class="border border-line bg-surface-alt px-3 py-1 text-xs font-bold text-ink-soft">Karatê</span>
          <span class="border border-line bg-surface-alt px-3 py-1 text-xs font-bold text-ink-soft">Ação social</span>
          <span class="border border-line bg-surface-alt px-3 py-1 text-xs font-bold text-ink-soft">Alto rendimento</span>
          <span class="border border-line bg-surface-alt px-3 py-1 text-xs font-bold text-ink-soft">Oeste Paulista</span>
        </div>
      </div>
      <div class="border-2 border-dashed border-gold-500 bg-surface-alt p-10 text-center">
        <p class="text-6xl" aria-hidden="true">🥋</p>
        <p class="mt-4 font-bold text-ink">Foto do dojo / treino</p>
        <p class="mt-1 text-xs text-ink-muted">Espaço reservado — aguardando fotos reais + logo em alta</p>
      </div>
    </div>
  </section>

  <!-- ATLETAS DESTAQUE -->
  <section class="py-20 bg-surface-alt border-y border-line">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-wrap items-end justify-between gap-4 mb-12">
        <div>
          <h2 class="font-display text-fluid-h2 font-bold tracking-tight text-ink uppercase">Atletas de alto desempenho</h2>
          <p class="mt-2 text-ink-soft">Quem já representa a região — medalhas e torneios em confirmação pelo responsável.</p>
        </div>
        <a href="/atletas" class="text-sm font-bold text-brand-600 hover:text-brand-700">Ver página dos atletas →</a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {athletes.map((a) => (
          <article class="border border-line bg-white p-6 flex flex-col shadow-hard">
            <div class="flex items-center gap-3">
              <span class="inline-flex h-12 w-12 items-center justify-center bg-brand-600 text-xl text-white" aria-hidden="true">🥋</span>
              <div>
                <h3 class="font-display text-fluid-h3 font-bold text-ink uppercase">{a.name}</h3>
                <p class="text-xs text-ink-muted">{a.category}</p>
              </div>
            </div>
            {a.badge && (
              <p class="mt-3 inline-flex w-fit items-center gap-1 border border-gold-500 bg-surface-alt px-3 py-1 text-xs font-bold text-gold-600">★ {a.badge}</p>
            )}
            <ul class="mt-3 space-y-1 text-sm text-ink-soft">
              {a.achievements.map((t) => (<li>• {t}</li>))}
            </ul>
            {a.pendingDetails && (<p class="mt-3 text-xs text-ink-muted">Detalhes e fotos em confirmação</p>)}
            <a href="/apoiar" class="mt-4 text-sm font-bold text-brand-600 hover:text-brand-700">Apoiar este atleta →</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- COMO AJUDAR -->
  <section id="apoiar-resumo" class="py-20 bg-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-fluid-h2 font-bold tracking-tight text-center text-ink uppercase">Sua doação vira viagem, medalha e futuro</h2>
      <p class="mt-3 text-center text-ink-soft">Para onde vai cada real — sem taxa escondida, com prestação de contas.</p>
      <div class="mt-10 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {costs.map((c) => (
          <div class="border border-line border-l-4 border-l-brand-600 bg-white p-6">
            <h3 class="font-display text-fluid-h3 font-bold text-ink uppercase">{c.label}</h3>
            <p class="mt-1 text-sm text-ink-soft">{c.desc}</p>
          </div>
        ))}
      </div>
      <div class="mt-10 border border-line bg-surface-alt p-8 text-center">
        <p class="text-sm font-bold text-gold-600">VALORES SUGERIDOS (toque para doar via PIX — chave em confirmação)</p>
        <div class="mt-4 flex flex-wrap justify-center gap-3">
          {giveAmounts.map((v) => (
            <a href="/apoiar" class="inline-flex min-h-[48px] min-w-[96px] items-center justify-center border border-line bg-white px-6 text-lg font-extrabold text-ink transition hover:border-brand-600 hover:bg-brand-600 hover:text-white">R$ {v}</a>
          ))}
        </div>
        <a href="/apoiar" class="mt-6 inline-flex min-h-[48px] items-center justify-center bg-brand-600 px-8 font-bold text-white shadow-hard transition hover:bg-brand-700">Quero apoiar agora</a>
      </div>
    </div>
  </section>

  <!-- PRIMEIROS PASSOS -->
  <section class="py-20 bg-white border-t border-line">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h1 class="font-display text-fluid-h1 font-extrabold text-ink uppercase tracking-tight leading-tight text-center mb-16">Primeiros passos</h1>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        <article class="flex flex-col">
          <div class="relative overflow-hidden shadow-hard"><img src="https://images.unsplash.com/photo-1555597673-b21d5c93e40e?w=600&h=400&fit=crop&q=80" alt="Atletas" class="w-full h-72 object-cover transition-transform duration-300 hover:scale-105" /></div>
          <h2 class="font-display text-fluid-h2 font-extrabold text-ink uppercase tracking-tight mt-6">Atletas</h2>
          <p class="mt-4 text-ink-soft leading-relaxed text-sm">Desde 1888, a AAU tem criado os líderes de amanhã nos parques infantis de todo o país.</p>
          <a href="#" class="mt-4 inline-flex items-center gap-2 text-sm font-bold text-brand-600 hover:text-brand-700 transition-colors uppercase tracking-wide">Saiba mais →</a>
        </article>
        <article class="flex flex-col">
          <div class="relative overflow-hidden shadow-hard"><img src="https://images.unsplash.com/photo-1511895426328-dc8714191300?w=600&h=400&fit=crop&q=80" alt="Pais" class="w-full h-72 object-cover transition-transform duration-300 hover:scale-105" /></div>
          <h2 class="font-display text-fluid-h2 font-extrabold text-ink uppercase tracking-tight mt-6">Pais</h2>
          <p class="mt-4 text-ink-soft leading-relaxed text-sm">Saiba o que é jogar AAU. Descubra tudo o que você precisa saber como pai.</p>
        </article>
        <article class="flex flex-col">
          <div class="relative overflow-hidden shadow-hard"><img src="https://images.unsplash.com/photo-1598550476439-6847785fcea6?w=600&h=400&fit=crop&q=80" alt="Treinadores" class="w-full h-72 object-cover transition-transform duration-300 hover:scale-105" /></div>
          <h2 class="font-display text-fluid-h2 font-extrabold text-ink uppercase tracking-tight mt-6">Treinadores</h2>
          <p class="mt-4 text-ink-soft leading-relaxed text-sm">Os treinadores são responsáveis pelo sucesso de um atleta dentro e fora do campo de jogo.</p>
          <a href="#" class="mt-4 inline-flex items-center gap-2 text-sm font-bold text-brand-600 hover:text-brand-700 transition-colors uppercase tracking-wide">Saiba mais →</a>
        </article>
        <article class="flex flex-col">
          <div class="relative overflow-hidden shadow-hard"><img src="https://images.unsplash.com/photo-1564415315947-0c8c4e8c7b5e?w=600&h=400&fit=crop&q=80" alt="Clubes" class="w-full h-72 object-cover transition-transform duration-300 hover:scale-105" /></div>
          <h2 class="font-display text-fluid-h2 font-extrabold text-ink uppercase tracking-tight mt-6">Clubes</h2>
          <p class="mt-4 text-ink-soft leading-relaxed text-sm">A AAU administra o principal programa nacional de licenciamento de árbitros do país.</p>
          <a href="#" class="mt-4 inline-flex items-center gap-2 text-sm font-bold text-brand-600 hover:text-brand-700 transition-colors uppercase tracking-wide">Saiba mais →</a>
        </article>
      </div>
    </div>
  </section>

  <!-- CONTATO -->
  <section id="contato" class="py-20 bg-surface-alt border-t border-line">
    <div class="mx-auto max-w-xl px-4 sm:px-6">
      <div class="text-center mb-10">
        <h2 class="font-display text-fluid-h2 font-bold text-ink uppercase">Fale com o dojo</h2>
        <p class="mt-2 text-sm text-ink-soft">Matrículas, apadrinhamento de atleta e patrocínio para empresas.</p>
      </div>
      <form action="/api/contact" method="POST" class="space-y-4 border border-line bg-white p-8 shadow-hard">
        <div>
          <label for="name" class="block text-sm font-bold text-ink">Seu nome</label>
          <input type="text" id="name" name="name" required autocomplete="name" class="mt-1 block w-full min-h-[48px] border border-line-strong bg-white px-3 py-2 text-base text-ink focus:border-brand-600 focus:outline-none" />
        </div>
        <div>
          <label for="email" class="block text-sm font-bold text-ink">Seu e-mail</label>
          <input type="email" id="email" name="email" required autocomplete="email" class="mt-1 block w-full min-h-[48px] border border-line-strong bg-white px-3 py-2 text-base text-ink focus:border-brand-600 focus:outline-none" />
        </div>
        <div>
          <label for="message" class="block text-sm font-bold text-ink">Mensagem (ex.: quero apadrinhar um atleta)</label>
          <textarea id="message" name="message" rows="4" required class="mt-1 block w-full border border-line-strong bg-white px-3 py-2 text-base text-ink focus:border-brand-600 focus:outline-none"></textarea>
        </div>
        <Turnstile theme="auto" />
        <Button type="submit" size="lg" variant="primary" class="w-full">Enviar mensagem</Button>
      </form>
    </div>
  </section>
</Layout>
